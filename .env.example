# Local infra (docker compose). Copy to `.env` and set real values.
# Never commit `.env`. Existing Postgres volumes keep the user/password
# they were first created with — changing these requires a volume reset.

POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel_db
POSTGRES_HOST_PORT=5555

REDIS_HOST_PORT=6379
OLLAMA_HOST_PORT=11434
