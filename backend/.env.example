DATABASE_URL=
PORT=3001
# The backend always runs in UTC (forced in src/common/utc-timezone.ts); keep tooling aligned.
TZ=UTC

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=
JWT_SECRET_REFRESH=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
SALT_ROUNDS=12

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES=3600

# Memory photo badges: multimodal Ollama model (`ollama pull gemma3:4b`).
# Leave MEMORY_BADGE_MODEL empty to disable badges.
OLLAMA_HOST=http://127.0.0.1:11434
MEMORY_BADGE_MODEL=gemma3:4b
MEMORY_BADGE_TIMEOUT_MS=120000

GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_CACHE_TTL_SECONDS=86400
DESTINATION_PLACE_RADIUS_KM=20
DESTINATION_PLACE_LIMIT=20

# Itinerary share links (https://<host>/s/<token>), opened in-app via App Links / Universal Links.
PUBLIC_SHARE_BASE_URL=http://localhost:3001
SHARE_LINK_TTL_DAYS=30
ANDROID_APP_PACKAGE=com.company.travel_frontend_v1
# Comma-separated SHA-256 fingerprints of the signing certificates (debug and release).
ANDROID_SHA256_CERT_FINGERPRINTS=
# Comma-separated <TeamID>.<bundle id>, e.g. ABCDE12345.com.example.travelFrontendV1
IOS_APP_ID=

