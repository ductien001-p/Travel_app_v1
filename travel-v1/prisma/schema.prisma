// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum AUTH_PROVIDER {
  LOCAL
  GOOGLE
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum USER_STATUS {
  BANED // Note: typo preserved for existing data; consider migration to BANNED
  ACTIVE
  INACTIVE
}

enum USER_ROLE {
  USER
  ADMIN
  HOST
}

enum HOST_STATUS {
  APPROVED
  REJECTED
  PENDING
  NONE
}

enum TRIP_TYPE {
  SOLO
  COUPLE
  FAMILY
  FRIENDS
  BACKPACKER
  OTHER
}

enum TRIP_ROLE {
  MEMBER
  ADMIN
  OWNER
}

enum TRIP_STATUS {
  DRAFT
  UPCOMING
  ONGOING
  CANCELLED
  COMPLETED
  NOTCOMPLETED
}

enum TRIP_VISIBILITY {
  PUBLIC
  PRIVATE
}

enum RECRUITMENT_STATE {
  NOT_PUBLISHED
  OPEN
  FULL
  CLOSED
}

enum RECRUITMENT_ORIGIN {
  PUBLISH_WIZARD
  EXISTING_TRIP
  LEGACY_BACKFILL
}

enum MEMBER_STATUS {
  ACTIVE
  LEFT
  KICKED
}

enum SocialPostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum FRIEND_REQUEST_STATUS {
  PENDING
  ACCEPTED
  REJECTED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum RANK {
  BEGINNER
  EXPLORER
  ADVENTURER
  TRAVELER
  LEGEND
}

enum VERIFICATION_LEVEL {
  NONE
  BASIC
  VERIFIED
  TRUSTED
}

enum BADGE_TYPE {
  FIRST_TRIP
  FREQUENT_TRAVELER
  LOCAL_GUIDE
  TRUSTED_HOST
  ADVENTURE_MASTER
}

enum TRIP_MESSAGE_TYPE {
  TEXT
  IMAGE
  SYSTEM
}

enum TIMELINE_EVENT_TYPE {
  TRIP_CREATED
  TRIP_PUBLISHED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_KICKED
  ACTIVITY_ADDED
  ACTIVITY_UPDATED
  ACTIVITY_DELETED
  ACTIVITY_CHECKIN
  EXPENSE_CREATED
  EXPENSE_SETTLED
  PHOTO_ADDED
  MEMORY_ADDED
  MEMORY_DELETED
  SYSTEM
}

enum TIMELINE_TARGET_TYPE {
  TRIP
  MEMBER
  ACTIVITY
  EXPENSE
  MEMORY
}

enum INVITATION_STATUS {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum JOIN_REQUEST_STATUS {
  PENDING
  APPROVED
  REJECTED
}

enum AdvertisementPlanType {
  BASIC
  FEATURED
  PREMIUM
}

enum AdvertisementStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  PAUSED
}

enum AdvertisementEventType {
  IMPRESSION
  CLICK
}

// ---------------------------------------------------------------------------
// User & Auth
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  googleId         String?   @unique
  username         String    @unique
  displayname      String
  email            String    @unique
  password         String?
  passwordChangeAt DateTime?

  phone       String?
  avatarId    String? @unique
  gender      String?
  dateofBirth String?
  address     String?
  bio         String?
  location    String?

  travelStyle UserTravelDNA[]
  budgetLevel BudgetLevel?
  languages   String[]        @default([])
  interests   String[]        @default([])

  provider AUTH_PROVIDER @default(LOCAL)

  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]

  role       USER_ROLE   @default(USER)
  status     USER_STATUS @default(INACTIVE)
  hostStatus HOST_STATUS @default(NONE)

  notificationEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  avatar UploadedMedia? @relation("UserAvatar", fields: [avatarId], references: [id])

  ownerTrips   Trip[]             @relation("TripOwner")
  trips        TripMember[]
  ranking      UserRanking?
  dailyRanking DailyLeaderboard[]

  createdPlaces Place[]        @relation("UserPlaces")
  placeReviews  PlaceReview[]
  savedPlaces            SavedPlace[]
  placeGallery           PlaceGallery[]
  placeCollections       PlaceCollection[]       @relation("PlaceCollectionOwner")
  placeCollectionRatings PlaceCollectionRating[] @relation("PlaceCollectionRater")

  notifications     Notification[]
  notificationsSent Notification[]  @relation("NotificationActor")
  uploadedMedia     UploadedMedia[]

  friendRequestsSent     FriendRequest[]      @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[]      @relation("FriendRequestTo")
  friendshipsAsUser      Friendship[]         @relation("FriendshipUser")
  friendshipsAsFriend    Friendship[]         @relation("FriendshipFriend")
  conversationsAsUser1   FriendConversation[] @relation("FriendConversationUser1")
  conversationsAsUser2   FriendConversation[] @relation("FriendConversationUser2")
  friendMessagesSent     FriendMessage[]
  posts                  Post[]
  postLikes              SocialPostLike[]
  tripMediaLikes         TripMediaLike[]
  postComments           SocialPostComment[]
  postShares             SocialPostShare[]
  following              UserFollow[]         @relation("UserFollowing")
  followers              UserFollow[]         @relation("UserFollowers")

  tripInvitationsSent     TripInvitation[] @relation("TripInvitationInviter")
  tripInvitationsReceived TripInvitation[] @relation("TripInvitationInvitee")
  tripJoinRequests        TripJoinRequest[] @relation("TripJoinRequestRequester")
  tripJoinRequestsDecided TripJoinRequest[] @relation("TripJoinRequestDecider")
  userTravelStats         UserTravelStats?
  placeVisits             PlaceVisit[]
  tripCheckins            TripCheckin[]
  tripShareLinks          TripShareLink[]
  tripPublishIdempotency  TripPublishIdempotency[]

  @@index([location])
  @@index([status])
}

enum TRAVEL_DNA_TYPE {
  //trip type
  SOLO_TRAVELER
  FAMILY_TRAVELER // NGUOI DU HANH GIA DINH
  COUPLE_TRAVELLER // LU KHACH CO DOI
  GROUP_TRAVELER //NGUOI KET NOI HANH TRINH

  //place
  BACKPACKER //PHUOT
  MOUNTAIN_LOVER // KE SAN MAY
  BEACH_LOVER //TIN DO BIEN XANH
  ADVENTURE_TRAVELER //NHA THAM HIEM
  FOODIE_TRAVELER //TIN DO AM THUC
  CULTURE_TRAVELER //NGUOI DU HANH VAN HOA
  ENTERTAINMENT_TRAVELLER //THO SAN NIEM VUI

  //media
  PHOTOGRAPHY_LOVER //THO SAN KHOANG KHAC
}

model UserTravelStats {
  id String @id @default(cuid())

  userId String @unique

  totalTrips      Int @default(0)
  totalActivities Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelDNAEvent {
  id String @id @default(cuid())

  checkinId String @unique
  userId    String

  createdAt DateTime @default(now())

  @@index([userId])
}

model UserTravelDNA {
  id String @id @default(cuid())

  userId String
  type   TRAVEL_DNA_TYPE

  score Int @default(0)

  tripTypeCount Int @default(0)
  activityCount Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model RefreshToken {
  id        String   @id @default(cuid())
  hashed    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model DeviceToken {
  id             String         @id @default(cuid())
  userId         String
  installationId String
  token          String         @unique
  platform       DevicePlatform
  deviceName     String?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Upload users images
// ---------------------------------------------------------------------------
model UploadedMedia {
  id        String  @id @default(cuid())
  userId    String?
  objectKey String  @unique
  avatarOf  User?   @relation("UserAvatar")

  mimeType String?
  fileSize Int?
  width    Int?
  height   Int?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user                     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  placeGalleries           PlaceGallery[]
  tripMedias               TripMedia[]
  postMedias               PostMedia[]
  tripExpenseReceipts      TripExpenseReceipt[]
  tripCovers               Trip[]               @relation("TripCoverMedia")
  destinationCatalogCovers DestinationCatalog[] @relation("DestinationCatalogCoverMedia")
  tripDestinationCovers    TripDestination[]    @relation("TripDestinationCoverMedia")

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Trips & Members
// ---------------------------------------------------------------------------

model Trip {
  id          String  @id @default(cuid())
  ownerId     String?
  name        String
  description String?

  startDate    DateTime
  endDate      DateTime
  budgetLevel  BudgetLevel?
  maxMembers   Int
  coverMediaId String?

  inviteCode String @unique

  tripType                 TRIP_TYPE       @default(OTHER)
  visibility               TRIP_VISIBILITY @default(PUBLIC)
  status                   TRIP_STATUS     @default(DRAFT)
  estimatedBudgetPerPerson Decimal?        @db.Decimal(14, 2)
  budgetCurrency           String?         @db.VarChar(3)

  // Join requests from the owner's friends skip the review queue.
  autoApproveFriends Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?

  owner          User?               @relation("TripOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  destinations   TripDestination[]
  itineraryItems ItineraryItem[]
  members        TripMember[]
  interests      TripInterest[]
  completions    TripCompletion[]
  expenses       TripExpense[]
  tripMessages   TripMessage[]
  timelineEvents TripTimelineEvent[]
  checkins       TripCheckin[]

  itineraryDays ItineraryDay[]
  notifications Notification[]

  invitations  TripInvitation[]
  joinRequests TripJoinRequest[]
  coverMedia   UploadedMedia?    @relation("TripCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  tripMedias  TripMedia[]
  shareLinks  TripShareLink[]
  recruitment TripRecruitment?
  publishIdempotencyKeys TripPublishIdempotency[]

  @@index([coverMediaId])
  @@index([visibility, status])
  @@index([ownerId])
  @@index([inviteCode])
  @@index([startDate])
  @@index([status])
  @@map("trips")
}

/// Public member recruitment for one trip. No row means the trip was never published.
model TripRecruitment {
  tripId                    String              @id
  state                     RECRUITMENT_STATE
  requirements              String?             @db.Text
  estimatedBudgetPerPerson  Decimal?            @db.Decimal(14, 2)
  publishedAt               DateTime?
  expiresAt                 DateTime?
  /// Publisher chose to show this post as urgent on destination feeds.
  urgent                    Boolean             @default(false)
  draftStep                 Int?
  origin                    RECRUITMENT_ORIGIN
  previousVisibility        TRIP_VISIBILITY?
  notifiedAt                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
  @@map("trip_recruitments")
}

/// Publish retries share one key per owner for 48 hours.
model TripPublishIdempotency {
  id        String   @id @default(cuid())
  ownerId   String
  key       String
  tripId    String
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  trip  Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([ownerId, key])
  @@index([createdAt])
  @@map("trip_publish_idempotency")
}

model TripDestination {
  id            String  @id @default(cuid())
  tripId        String
  destinationId String?

  city    String
  country String
  lat     Float
  lng     Float

  // Snapshot metadata copied from DestinationCatalog when the stop is added.
  // This keeps an existing trip stable when catalog content changes later.
  destinationType String?
  highlights      String[] @default([])
  coverMediaId    String?

  order     Int // thứ tự trong hành trình: 1, 2, 3...
  startDate DateTime // ngày đến điểm này (optional, nếu muốn breakdown lịch trình theo chặng)
  endDate   DateTime // ngày rời điểm này

  trip          Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination   DestinationCatalog? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  coverMedia    UploadedMedia?      @relation("TripDestinationCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  itineraryDays ItineraryDay[]

  @@unique([tripId, order])
  @@index([tripId])
  @@index([destinationId])
  @@index([coverMediaId])
}

/// Curated, reusable city/destination content used while planning a trip.
/// TripDestination stores a snapshot of the display metadata above.
model DestinationCatalog {
  id           String   @id @default(cuid())
  name         String
  country      String
  lat          Float
  lng          Float
  type         String?
  highlights   String[] @default([])
  coverMediaId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coverMedia       UploadedMedia?    @relation("DestinationCatalogCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  tripDestinations TripDestination[]

  @@unique([name, country])
  @@index([country, name])
  @@index([coverMediaId])
}

//memories + caption cho trip
/// Context of a memory photo, suggested by a vision model.
enum MEMORY_BADGE {
  NIGHT
  SCENERY
  PEOPLE
  FOOD
}

model TripMedia {
  id        String   @id @default(cuid())
  tripId    String
  caption   String?
  mediaId   String   @unique
  createdAt DateTime @default(now())

  badge          MEMORY_BADGE?
  /// Null while the photo waits for classification; badge may stay null after.
  badgeCheckedAt DateTime?

  /// Denormalized count of TripMediaLike rows. Likes are not social-post likes.
  likeCount Int @default(0)

  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  media UploadedMedia  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  likes TripMediaLike[]

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([badgeCheckedAt, createdAt])
}

/// One like per viewer on a trip memory photo. Separate from SocialPostLike.
model TripMediaLike {
  id          String   @id @default(cuid())
  tripMediaId String
  userId      String
  createdAt   DateTime @default(now())

  tripMedia TripMedia @relation(fields: [tripMediaId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripMediaId, userId])
  @@index([userId])
}

model ItineraryDay {
  id            String          @id @default(cuid())
  tripId        String
  destinationId String
  dayNumber     Int
  date          DateTime
  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination   TripDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  activities    ItineraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@index([destinationId])
  @@index([tripId, date])
}

//KHI USER NHAP TITLE THI HE THOGN SE DUA VAO TITLE DE GOI Y PLACE CHO USER
//1: db co dia diem thi user nhap title va show ra dia diem cho user chon
//2. neu user muon kiem them dia diem khac thi dung ai 
//3. user chon luon dia diem minh muon ma chua co trong db hoac da co
model ItineraryItem {
  id                String    @id @default(cuid())
  dayId             String
  placeId           String //Neu user da co dia 
  tripId            String
  title             String // tên hoạt động, không phụ thuộc place.name (VD: "Ăn trưa tại...")
  notes             String?
  startTime         DateTime?
  estimatedDuration Int?
  estimatedCost     Decimal?  @db.Decimal(12, 2) // nếu có tính năng budget
  isCheckin         Boolean   @default(false)
  orderIndex        Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  place    Place         @relation(fields: [placeId], references: [id], onDelete: Restrict)
  day      ItineraryDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  checkins TripCheckin[]

  @@index([tripId, placeId])
  @@index([dayId])
  @@index([dayId, orderIndex])
}

model TripInterest {
  id         String @id @default(cuid())
  tripId     String
  interestId String

  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, interestId])
  @@index([tripId])
  @@index([interestId])
}

model Interest {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  tripInterests TripInterest[]

  @@map("interest")
}

model TripMember {
  id     String @id @default(cuid())
  tripId String
  userId String

  role   TRIP_ROLE     @default(MEMBER)
  status MEMBER_STATUS @default(ACTIVE)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  notificationEnabled Boolean @default(true)

  trip               Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripCheckins       TripCheckin[]
  completion         TripCompletion?
  tripExpenses       TripExpense[]       @relation("ExpensePayer")
  expenseSplits      TripExpenseSplit[]  @relation("ExpenseSplitMember")
  tripMessages       TripMessage[]
  tripTimelineEvents TripTimelineEvent[]

  @@unique([tripId, userId])
  @@index([userId])
  @@index([tripId, status])
  @@map("trip_members")
}

model TripInvitation {
  id        String            @id @default(cuid())
  tripId    String
  inviterId String
  inviteeId String
  status    INVITATION_STATUS @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  inviter User @relation("TripInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("TripInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([tripId, inviteeId])
  @@index([inviteeId, status])
  @@index([tripId])
  @@map("trip_invitations")
}

// A user asking to join with the invite code; OWNER/ADMIN approve or reject.
// One row per (trip, requester): asking again reopens the previous request.
model TripJoinRequest {
  id          String              @id @default(cuid())
  tripId      String
  requesterId String
  status      JOIN_REQUEST_STATUS @default(PENDING)
  message     String?             @db.VarChar(500)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  requester User  @relation("TripJoinRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("TripJoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([tripId, requesterId])
  @@index([tripId, status, createdAt])
  @@index([requesterId])
  @@index([decidedById])
  @@map("trip_join_requests")
}

model TripCheckin {
  id         String   @id @default(cuid())
  tripId     String
  userId     String
  placeId    String
  memberId   String
  activityId String?
  latitude   Float
  longitude  Float
  visitedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  place    Place          @relation(fields: [placeId], references: [id], onDelete: Restrict)
  member   TripMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  activity ItineraryItem? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([tripId, userId, placeId])
  @@index([activityId])
  @@index([memberId])
  @@index([memberId, createdAt])
}

// Read-only itinerary link. Only the SHA-256 of the token is stored.
model TripShareLink {
  id          String    @id @default(cuid())
  tripId      String
  createdById String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdById])
}

//Luu hoàn thành chuyến đi và cộng điểm cho user mỗi trip
model TripCompletion {
  id            String   @id @default(cuid())
  tripId        String
  memberId      String   @unique
  completedAt   DateTime @default(now())
  pointsAwarded Int

  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([memberId])
}

enum EXPENSE_CATEGORY {
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITY
  SHOPPING
  OTHER
}

enum CURRENCY {
  VND
  USD
}

enum EXPENSE_SPLIT_TYPE {
  EQUAL
  CUSTOM
}

model TripExpense {
  id           String             @id @default(cuid())
  tripId       String
  payerId      String
  amount       Decimal            @db.Decimal(12, 2)
  currency     CURRENCY           @default(VND)
  category     EXPENSE_CATEGORY
  splitType    EXPENSE_SPLIT_TYPE
  description  String?
  /// When the money was actually spent (may differ from createdAt).
  spentAt      DateTime           @default(now())
  locationNote String?            @db.VarChar(200)
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer TripMember @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)

  splits   TripExpenseSplit[]
  receipts TripExpenseReceipt[]

  @@index([tripId])
  @@index([payerId])
  @@index([tripId, spentAt])
}

model TripExpenseReceipt {
  id        String   @id @default(cuid())
  expenseId String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  expense TripExpense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  media   UploadedMedia @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([expenseId, mediaId])
  @@index([expenseId])
  @@index([mediaId])
}

//TIEN PHAI TRA CUA MOI USER
model TripExpenseSplit {
  id           String  @id @default(cuid())
  expenseId    String
  tripMemberId String
  amount       Decimal @db.Decimal(12, 2)
  isSettled    Boolean @default(false) //KHOANG TIEN DA DUOC THANH TOAN CHUA

  expense TripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  TripMember  @relation("ExpenseSplitMember", fields: [tripMemberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, tripMemberId])
}

model TripMessage {
  id          String            @id @default(cuid())
  tripId      String
  senderId    String
  content     String
  messageType TRIP_MESSAGE_TYPE @default(TEXT)
  createdAt   DateTime          @default(now())

  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sender TripMember @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([senderId])
}

model TripTimelineEvent {
  id         String                @id @default(cuid())
  tripId     String
  type       TIMELINE_EVENT_TYPE
  memberId   String
  content    String
  // Snapshot of the event at the time it happened, shaped per `type`
  // (see trip-timeline/timeline-metadata.ts). Null for events recorded
  // before metadata existed.
  metadata   Json?
  targetType TIMELINE_TARGET_TYPE?
  targetId   String?
  createdAt  DateTime              @default(now())

  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([tripId, type, createdAt])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------
enum NOTIFICATION_TYPE {
  TRIP_INVITATION
  TRIP_INVITATION_ACCEPTED
  TRIP_INVITATION_REJECTED
  TRIP_JOIN_REQUEST
  TRIP_JOIN_REQUEST_APPROVED
  TRIP_JOIN_REQUEST_REJECTED
  TRIP_MEMBER_JOINED
  TRIP_MEMBER_LEFT
  TRIP_MEMBER_REMOVED
  TRIP_ROLE_CHANGED
  TRIP_UPDATED
  TRIP_STARTING_SOON
  TRIP_RECRUITMENT_CLOSED
  TRIP_RECRUITMENT_DATES_CHANGED
  TRIP_RECRUITMENT_INCOMPLETE

  POST_LIKE
  POST_COMMENT
  POST_MENTION

  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED

  SYSTEM_ANNOUNCEMENT
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  actorId   String?
  tripId    String?
  type      NOTIFICATION_TYPE
  title     String
  message   String
  isRead    Boolean           @default(false)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  trip  Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([tripId])
}

// ---------------------------------------------------------------------------
// Friends & Friend Chat
// ---------------------------------------------------------------------------

model FriendRequest {
  id         String                @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FRIEND_REQUEST_STATUS @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model FriendConversation {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1    User            @relation("FriendConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User            @relation("FriendConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages FriendMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model FriendMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    String   @default("TEXT")
  createdAt      DateTime @default(now())

  conversation FriendConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Trust & Reputation
// ---------------------------------------------------------------------------

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model UserRanking {
  userId         String   @id
  totalPoints    Int      @default(0)
  tripsCompleted Int      @default(0)
  rank           RANK     @default(BEGINNER)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
}

model DailyLeaderboard {
  id     String @id @default(cuid())
  userId String

  points  Int
  ranking Int
  date    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date, ranking])
}

// ---------------------------------------------------------------------------
// Community Places
// ---------------------------------------------------------------------------
enum PLACE_CATEGORY {
  //FOOD
  FOOD
  CAFE

  //ACCOMMODATION
  HOTEL
  RESORT
  HOSTEL
  HOMESTAY
  VILLA

  //THIEN NHIEN
  MOUNTAIN
  BEACH
  CAVE
  WATERFALL //THAC NUOC
  LAKE
  CAMPING

  //VAN HOA
  MUSEUM
  TEMPLES
  CHURCH
  HISTORICAL_SITE
  MONUMENT // TUONG DAI TUONG NIEM
  PALACE //cUNG DIEN, DINH THU
  CASTLE
  OLD_TOWN

  //VUI CHOI GIAI TRI
  ZOO
  WATER_PARK
  PARK
  CINEMA
  THEATER // NHA HAT, NHA KICH
  NIGHT_MARKET
  SHOPPING_MALL // VINCOME
  MARKET // CHO TRUYEN THONG
  ZIPLINE //CAP TREO
  WALKING_STREET // PHO DI BO
}

enum PlaceStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum PlaceCollectionVisibility {
  PRIVATE
  PUBLIC
}

model Place {
  id          String  @id @default(uuid())
  name        String
  description String?

  category PLACE_CATEGORY

  city      String
  country   String
  address   String
  latitude  Float
  longitude Float

  status PlaceStatus @default(PENDING)

  embedding Unsupported("vector(768)")?

  averageRating Float         @default(0)
  reviews       PlaceReview[]
  visitCount    PlaceVisit[]
  savedPlaces     SavedPlace[]
  collectionItems PlaceCollectionItem[]
  posts           Post[]

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser User? @relation("UserPlaces", fields: [createdByUserId], references: [id], onDelete: SetNull)

  coverImages  PlaceGallery[]
  activities   ItineraryItem[]
  tripCheckins TripCheckin[]

  @@index([city])
  @@index([category])
  @@index([latitude, longitude])
}

enum GalleryStatus {
  ACTIVE
  HIDDEN
}

model PlaceGallery {
  id String @id @default(cuid())

  placeId String
  mediaId String
  isCover Boolean @default(false)

  uploadedById String

  score Float @default(0)

  status GalleryStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  media UploadedMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([placeId, mediaId])
  @@index([placeId, status])
  @@index([placeId, score])
}

model PlaceVisit {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  visitedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // Một user chỉ được tính là đã ghé một place một lần
  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
}

model PlaceReview {
  id        String   @id @default(uuid())
  placeId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
}

model SavedPlace {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
}

model PlaceCollection {
  id                 String                     @id @default(uuid())
  ownerId            String
  title              String                     @db.VarChar(80)
  visibility         PlaceCollectionVisibility  @default(PRIVATE)
  sourceCollectionId String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  owner            User                    @relation("PlaceCollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sourceCollection PlaceCollection?        @relation("PlaceCollectionCopies", fields: [sourceCollectionId], references: [id], onDelete: SetNull)
  copies           PlaceCollection[]       @relation("PlaceCollectionCopies")
  items            PlaceCollectionItem[]
  ratings          PlaceCollectionRating[]

  @@unique([ownerId, sourceCollectionId])
  @@index([ownerId, createdAt])
  @@index([visibility, sourceCollectionId])
  @@index([sourceCollectionId])
}

model PlaceCollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  placeId      String
  createdAt    DateTime @default(now())

  collection PlaceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  place      Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, placeId])
  @@index([placeId])
  @@index([collectionId, createdAt])
}

model PlaceCollectionRating {
  id           String   @id @default(uuid())
  collectionId String
  userId       String
  rating       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection PlaceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User            @relation("PlaceCollectionRater", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId])
}

//Social Post
model Post {
  id            String               @id @default(cuid())
  authorId      String
  placeId       String?
  caption       String               @db.VarChar(1000)
  visibility    SocialPostVisibility @default(PUBLIC)
  likesCount    Int                  @default(0)
  commentsCount Int                  @default(0)
  sharesCount   Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes      SocialPostLike[]
  comments   SocialPostComment[]
  postMedias PostMedia[]
  shares     SocialPostShare[]

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([authorId, createdAt])
  @@index([placeId, createdAt])
  @@index([visibility, createdAt])
  @@index([createdAt])
}

model PostMedia {
  id         String   @id @default(cuid())
  postId     String
  mediaId    String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  post  Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  media UploadedMedia @relation(fields: mediaId, references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId, orderIndex])
}

model SocialPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model SocialPostComment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  content   String    @db.VarChar(1000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model SocialPostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}
